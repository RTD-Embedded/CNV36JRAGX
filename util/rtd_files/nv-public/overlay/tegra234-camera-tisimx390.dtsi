				//gpio-hog;
				output-low;
				gpios = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x1>;
				label = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
				
				//line-name = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
			};
			tis_fpdlink_e_outhigh {
				status = "disabled";
			};
		};

		tis_fpdlink_f: tis_fpdlink@3d { // 3d 
			compatible = "tis,tis-fpdlink";
			status = "okay";
			reg = <0x3d>;
			gpio_addr_base = /bits/ 8 <0x6a>;          // ?????????????
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			deser_lanes = <4>;
			deser_chan_addrs = /bits/ 8 <0x4b 0x4c>;
			
			sensors = <&tis_imx390_f>;
			
			tis_fpdlink_f_input {
				status = "okay";
				input;
				gpios = <0x7 0x0>;
				label = "tis_fpdlink_a_chn0_input_0";

				//line-name = "tis_fpdlink_a_chn0_input_0";
			};
			tis_fpdlink_f_outlow {
				status = "okay";
				//gpio-hog;
				output-low;
				gpios = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x1>;
				label = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
				
				//line-name = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
			};
			tis_fpdlink_f_outhigh {
				status = "disabled";
			};
		};

