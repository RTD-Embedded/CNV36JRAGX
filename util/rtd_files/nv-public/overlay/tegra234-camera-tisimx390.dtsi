			 	tis_imx390_b: tis_imx390@1b {
					compatible = "tis,tis_imx390";
					reg = <0x1b>;
					reg-tis_eeprom = <0x51>;
					reg-nv_eeprom = <0x58>;
					status = "okay";
					reset-gpios = <&tis_fpdlink_b 1 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tis_fpdlink_b 0 GPIO_ACTIVE_HIGH>;
					gpoutlevel-gpios = <&tis_fpdlink_b 2 GPIO_ACTIVE_HIGH>;
					gpoutpushpull-gpios = <&tis_fpdlink_b 3 GPIO_ACTIVE_HIGH>;
					gpoutselect-gpios = <&tis_fpdlink_b 4 GPIO_ACTIVE_HIGH>;
					triglvlsel-gpios = <&tis_fpdlink_b 5 GPIO_ACTIVE_HIGH>;
					trigsrcsel-gpios = <&tis_fpdlink_b 6 GPIO_ACTIVE_HIGH>;
					devnode = "video1";
					physical_w = "5.640";
					physical_h = "3.216";
					sensor_model = "imx390";
					use_decibel_gain = "true";
					use_sensor_mode_id = "true";
					fpdlink = <&tis_fpdlink_b>;
					fpdlink_signals = "default";
					
					fpdlink_clkout_hz = <27000000>;
					fpdlink_slave_map = /bits/ 8 <0x21 0x1b 0x50 0x51 0x57 0x58>;
