		channel@0 {
				reg = <0>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						tis_imx390_csi_in0: endpoint@0 {
							port-index = <0>;
							bus-width = <2>;
							remote-endpoint = <&tis_imx390_out0>;
						};
					};
					port@1 {
						reg = <1>;
						tis_imx390_csi_out0: endpoint@1 {
							remote-endpoint = <&tis_imx390_vi_in0>;
						};
					};
				};
			};
			channel@1 {
				reg = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						tis_imx390_csi_in1: endpoint@2 {
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&tis_imx390_out1>;
						};
					};
					port@1 {
						reg = <1>;
						tis_imx390_csi_out1: endpoint@3 {
							remote-endpoint = <&tis_imx390_vi_in1>;
						};
					};
				};
			};
			channel@2 {
				reg = <2>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						tis_imx390_csi_in2: endpoint@4 {
							port-index = <2>;
							bus-width = <2>;
							remote-endpoint = <&tis_imx390_out2>;
						};
					};
					port@1 {
						reg = <1>;
						tis_imx390_csi_out2: endpoint@5 {
							remote-endpoint = <&tis_imx390_vi_in2>;
						};
					};
				};
			};
			channel@3 {
				reg = <3>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						tis_imx390_csi_in3: endpoint@6 {
							port-index = <3>;
							bus-width = <2>;
							remote-endpoint = <&tis_imx390_out3>;
						};
					};
					port@1 {
						reg = <1>;
						tis_imx390_csi_out3: endpoint@7 {
							remote-endpoint = <&tis_imx390_vi_in3>;
						};
					};
				};
			}; 
			channel@4 {
				reg = <4>;
				ports {
