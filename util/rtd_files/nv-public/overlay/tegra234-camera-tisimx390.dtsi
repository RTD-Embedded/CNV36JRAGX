	i2c@3180000 {
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		nvidia,disable-multi-pkt-mode;

		tis_fpdlink_a: tis_fpdlink@30 {
			compatible = "tis,tis-fpdlink";
			status = "okay";
			reg = <0x30>;
			gpio_addr_base = /bits/ 8 <0x60>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			deser_lanes = <2>;
			deser_chan_addrs = /bits/ 8 <0x41 0x42>;
			
			sensors = <&tis_imx390_a>;
			
			tis_fpdlink_a_input {
				status = "okay";
				input;
				gpios = <0x7 0x0>;
				gpio-line-names = "tis_fpdlink_a_chn0_input_0";
				//line-name = "tis_fpdlink_a_chn0_input_0";
			};
			tis_fpdlink_a_outlow {
				status = "okay";
				//gpio-hog;
				output-low;
				gpios = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x1>;
				gpio-line-names = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
				//line-name = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
			};
			tis_fpdlink_a_outhigh {
				status = "disabled";
			};
			
		};

		tis_fpdlink_b: tis_fpdlink@32 {
			compatible = "tis,tis-fpdlink";
			status = "okay";
			reg = <0x32>;
			gpio_addr_base = /bits/ 8 <0x62>;          // ?????????????
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			deser_lanes = <2>;
			deser_chan_addrs = /bits/ 8 <0x43 044>;
			
			sensors = <&tis_imx390_b>;
			
			tis_fpdlink_b_input {
				status = "okay";
				input;
				gpios = <0x7 0x0>;
				label = "tis_fpdlink_a_chn0_input_0";
				//line-name = "tis_fpdlink_a_chn0_input_0";
			};
			tis_fpdlink_b_outlow {
				status = "okay";
				//gpio-hog;
				output-low;
				gpios = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x1>;
				label = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
				
				//line-name = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
			};
			tis_fpdlink_b_outhigh {
				status = "disabled";
			};
		};

		tis_fpdlink_c: tis_fpdlink@34 {
			compatible = "tis,tis-fpdlink";
			status = "okay";
			reg = <0x34>;
			gpio_addr_base = /bits/ 8 <0x64>;          // ?????????????
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			deser_lanes = <2>;
			deser_chan_addrs = /bits/ 8 <0x45 0x46>;
			
			sensors = <&tis_imx390_c>;
			
			tis_fpdlink_c_input {
				status = "okay";
				input;
				gpios = <0x7 0x0>;
				label = "tis_fpdlink_a_chn0_input_0";
				//line-name = "tis_fpdlink_a_chn0_input_0";
			};
			tis_fpdlink_c_outlow {
				status = "okay";
				//gpio-hog;
				output-low;
				gpios = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x1>;
				label = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
				
				//line-name = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
			};
			tis_fpdlink_c_outhigh {
				status = "disabled";
			};
		};

		tis_fpdlink_d: tis_fpdlink@36 {
			compatible = "tis,tis-fpdlink";
			status = "okay";
			reg = <0x36>;
			gpio_addr_base = /bits/ 8 <0x66>;          // ?????????????
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			deser_lanes = <2>;
			deser_chan_addrs = /bits/ 8 <0x47 0x48>;
			
			sensors = <&tis_imx390_d>;
			
			tis_fpdlink_d_input {
				status = "okay";
				input;
				gpios = <0x7 0x0>;
				label = "tis_fpdlink_a_chn0_input_0";
				//line-name = "tis_fpdlink_a_chn0_input_0";
			};
			tis_fpdlink_d_outlow {
				status = "okay";
				//gpio-hog;
				output-low;
				gpios = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x1>;
				label = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
				
				//line-name = "tis_fpdlink_a_chn0_CAM_PWR", "tis_fpdlink_a_chn0_RESET", "tis_fpdlink_a_chn0_GPOUT_LEVEL", "tis_fpdlink_a_chn0_GPOUT_PUSHPULL", "tis_fpdlink_a_chn0_GPOUT_SELECT", "tis_fpdlink_a_chn0_TRIG_LVL_SEL", "tis_fpdlink_a_chn0_TRIG_SRC_SEL";
			};
			tis_fpdlink_d_outhigh {
				status = "disabled";
			};
		};
		tis_fpdlink_e: tis_fpdlink@3c { // 3d 
			compatible = "tis,tis-fpdlink";
			status = "okay";
			reg = <0x3c>;
			gpio_addr_base = /bits/ 8 <0x68>;          // ?????????????
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
			deser_lanes = <4>;
			deser_chan_addrs = /bits/ 8 <0x49 0x4a>;
			
			sensors = <&tis_imx390_e>;
			
			tis_fpdlink_e_input {
				status = "okay";
				input;
				gpios = <0x7 0x0>;
				label = "tis_fpdlink_a_chn0_input_0";

				//line-name = "tis_fpdlink_a_chn0_input_0";
